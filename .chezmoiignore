# Repo tooling that does not start with a dot is a deploy target unless it is listed here -- chezmoi
# skips source entries beginning with '.' automatically (which is why .pre-commit-config.yaml, .yamllint
# and .github/ need no entry), but everything else in this list would otherwise land in $HOME. Verified
# with `chezmoi target-path --source . commitlint.config.js`, which resolves to ~/commitlint.config.js
# without this line.
commitlint.config.js
DESIGN.md
krew-plugins.txt
mise.toml
README.md
TESTING.md

# Design rationale for the deployed global CLAUDE.md. It sits beside its template for
# discoverability, but it is maintainer documentation for this repo, not agent
# instructions — it must never land in ~/.claude.
.claude/MAINTAINER.md

# Keep mise.lock out of chezmoi's deploy path
#   mise rewrites ~/.config/mise/mise.lock in place whenever it has to lock something the deployed lockfile
#   doesn't already cover, which is exactly what run_after_20_mise-upgrade asks it to do. Verified on a
#   throwaway pod from this branch: with this line removed, one `chezmoi apply --force` left
#   `MM .config/mise/mise.lock` behind, and the next non-interactive apply hard-failed -- chezmoi asked
#   "has changed since chezmoi last wrote it?" with no TTY to answer on. With the line in place the same
#   sequence is clean. run_after_20_mise-upgrade copies the file in from the source directory instead.
.config/mise/mise.lock

# Do not collapse this homeDir guard into `eq .chezmoi.os "linux"`. The implication only runs one way: a coder
# workspace is always Linux, but Linux is not always a coder workspace -- GitHub Actions runners (/home/runner)
# and throwaway test pods are Linux too. An OS check would start ignoring private_Library/** in CI and in test
# pods, which is a behaviour change, not a cleanup.
{{- if eq .chezmoi.homeDir "/home/coder" }}
Library/
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
.vscode-server/
{{- end }}

# The agent GitHub App identity ships only to coder workspaces (agent pods). Same one-way
# implication as the homeDir guard above: CI runners and test pods are Linux but must not
# grow an agent identity, so guard on homeDir, never on os. The workspace signing key is
# part of the same identity set: it exists so pods can satisfy required_signatures without
# carrying the personal authentication key, and no other machine class should have it.
{{- if ne .chezmoi.homeDir "/home/coder" }}
.config/gh-agent/
.local/bash/gh-agent.bash
.local/bin/gh-app-env
.ssh/id_ed25519_signing
{{- end }}

# The personal SSH key is an *authentication* key: anything holding it can push over SSH
# as the human, which routes around the App identity above -- a ruleset would still stop
# the merge, but the acting identity on a push would be the human again. So the key pair
# renders on laptops only, never on coder workspaces; pods sign with the workspace-only
# signing key and push with the App token over HTTPS. Guard on homeDir, never on os, for
# the same one-way-implication reason as above. Note: ignoring only stops managing the
# files -- a pod that already has the key keeps it until it is deleted there.
{{- if eq .chezmoi.homeDir "/home/coder" }}
.ssh/id_ed25519
.ssh/id_ed25519.pub
{{- end }}
