# Keep mise.lock out of chezmoi's deploy path (#728) -- still required after the single-install collapse.
# mise rewrites ~/.config/mise/mise.lock in place whenever it has to lock something the deployed lockfile
# doesn't already cover, which is exactly what run_after_20_mise-upgrade asks it to do. Verified on a
# throwaway pod from this branch: with this line removed, one `chezmoi apply --force` left
# `MM .config/mise/mise.lock` behind, and the next non-interactive apply hard-failed -- chezmoi asked
# "has changed since chezmoi last wrote it?" with no TTY to answer on. With the line in place the same
# sequence is clean. run_after_20_mise-upgrade copies the file in from the source directory instead.
.config/mise/mise.lock

# Do not collapse this homeDir guard into `eq .chezmoi.os "linux"`. The implication only runs one way: a coder
# workspace is always Linux, but Linux is not always a coder workspace -- GitHub Actions runners (/home/runner)
# and throwaway test pods are Linux too. An OS check would start ignoring private_Library/** in CI and in test
# pods, which is a behaviour change, not a cleanup.
{{- if eq .chezmoi.homeDir "/home/coder" }}
Library/
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
.vscode-server/
{{- end }}

# The agent GitHub App identity ships only to coder workspaces (agent pods). Same one-way
# implication as the homeDir guard above: CI runners and test pods are Linux but must not
# grow an agent identity, so guard on homeDir, never on os.
{{- if ne .chezmoi.homeDir "/home/coder" }}
.config/gh-agent/
.local/bash/gh-agent.bash
.local/bin/gh-app-env
{{- end }}
