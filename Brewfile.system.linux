# Baseline System Packages
brew "bash-completion@2"  # completion framework the generated completions in run_after_60 rely on
brew "gnupg"
brew "nmap"
brew "starship"

# Package Managers
brew "mise"
brew "oven-sh/bun/bun"
brew "uv"

# Dotfile Manager
brew "chezmoi"

# Fonts are installed via .chezmoiscripts/run_after_32_fonts.sh.tmpl on Linux -
# Homebrew font casks download into the Caskroom but never reach fontconfig here.
