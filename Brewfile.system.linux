# Baseline System Packages
brew "gnupg"
brew "nmap"
brew "starship"

# Package Managers
brew "mise"
brew "oven-sh/bun/bun"
brew "uv"

# Dotfile Manager
brew "chezmoi"

# Fonts are installed via `[bootstrap.packages]` in private_dot_config/mise/conf.d/linux.toml on
# Linux (applied by run_after_20_mise-standard.sh.tmpl), not via Homebrew casks: Homebrew font
# casks download into the Caskroom but never reach fontconfig here. mise itself writes straight
# into $XDG_DATA_HOME/fonts, which is why it works where a `brew` cask wouldn't (#747).
