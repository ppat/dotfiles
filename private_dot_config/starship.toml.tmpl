"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true
continuation_prompt = '▶▶ '

# Stable environment cues precede cwd state; the black handoff grounds Git only when it is present.
format = """
{{- if eq .chezmoi.os "darwin" }}
[](macos)\
{{- else }}
[](host)\
{{- end }}
$os\
$hostname\
{{- if eq .chezmoi.os "darwin" }}
[](bg:kubernetes fg:macos)\
{{- else }}
[](bg:kubernetes fg:host)\
{{- end }}
$kubernetes\
[](bg:directory fg:kubernetes)\
$directory\
[ ](bg:black fg:directory)\
($git_branch$git_state$git_commit)\
$cmd_duration\
$fill\
$jobs\
$memory_usage\
$battery\
$time\
$line_break\
$status\
$character"""

palette = 'calm_dark'


[character]
success_symbol = '[➜](bold fg:green) '
error_symbol = '[✗](bold fg:red) '

[directory]
style = "bg:directory fg:text"
format = "[ $read_only$path ]($style)"
read_only = "   "
truncation_length = 3
truncate_to_repo = true
substitutions = [
 { from = "~/Documents", to = "󰈙  Documents " },
 { from = "~/Downloads", to = "  Downloads " },
 { from = "~/Music", to = "󰝚  Music " },
 { from = "~/Pictures", to = "  Pictures " },
 { from = "~/code", to = "󰲋  code " }
]

[fill]
symbol = ' '

[hostname]
ssh_only = false
{{- if eq .chezmoi.os "darwin" }}
style = "bg:macos fg:text"
{{- else }}
style = "bg:host fg:text"
{{- end }}
format = '[ $hostname ]($style)'

[git_branch]
# Git intentionally shares terminal black, avoiding another floating color panel.
symbol = ""
style = "bg:black fg:git"
format = '[ $symbol $branch ]($style)'

[git_commit]
style = "bg:black fg:git"
format = '[($hash)]($style)'
only_detached = true
tag_disabled = true

[git_state]
style = "bg:black fg:git"
format = '[$state( $progress_current/$progress_total)]($style)'

[kubernetes]
disabled = false
symbol = "󱃾 "
format = '[ [$symbol](bold bg:kubernetes fg:kubernetes_icon) $context \($namespace\) ]($style)'
style = "bg:kubernetes fg:text"

[[kubernetes.contexts]]
# One dark surface keeps changing context foregrounds legible; risk remains a foreground cue.
context_pattern = "^homelab$"
context_alias = "homelab"
style = "bg:kubernetes bold fg:prod"

[[kubernetes.contexts]]
context_pattern = "^nas$"
context_alias = "nas"
style = "bg:kubernetes fg:prod_alt"

[[kubernetes.contexts]]
context_pattern = "^admin@sandbox-talos$"
context_alias = "sandbox-talos"
style = "bg:kubernetes fg:sandbox"

[os]
disabled = false
format = '[ $symbol]($style)'
{{- if eq .chezmoi.os "darwin" }}
style = "bg:macos fg:text"
{{- else }}
style = "bg:host fg:text"
{{- end }}

[os.symbols]
Alpine = ""
Debian = "󰣚"
Linux = "󰌽"
Macos = "󰀵"
Raspbian = "󰐿"
Ubuntu = "󰕈"
Windows = ""

[status]
map_symbol = true
pipestatus = true
disabled = false

[time]
disabled = false
time_format = "%R"
style = "bg:black fg:utility"
{{- if ne .chezmoi.os "darwin" }}
# IANA time zone keeps Eastern time correct across daylight-saving transitions.
utc_time_offset = "America/New_York"
{{- end }}
format = '[  $time ]($style)'

[line_break]
disabled = false
# ------------------------- MODULES ENABLED ON CERTAIN SCENARIOS ------------------------------
{{- if eq .chezmoi.os "darwin" }}
[[battery.display]]
threshold = 10
style = 'bold red'

[[battery.display]]
threshold = 25
style = 'bold yellow'

[[battery.display]]
threshold = 100
style = 'bg:black fg:utility'

[memory_usage]
symbol = '󰍛'
style = 'bg:black fg:utility'
format = ' $symbol [${ram_pct}( | ${swap_pct})]($style) '
threshold = -1
disabled = false
{{- end }}

[palettes.calm_dark]
# Tuned for dark terminals: restrained brightness and chroma reduce glare and eye strain during long sessions,
# while separated dark surfaces and sufficient text contrast keep adjacent prompt states easy to scan.
# Accents are reserved for risk and environment state.
crust = "#11111b"
black = "#000000"
text = "#cdd6f4"
# macOS uses muted maroon as a caution cue; other hosts stay cool and neutral.
macos = "#6d4855"
host = "#2b5b64"
directory = "#3d5272"
git = "#83a9ab"
kubernetes = "#25213a"
# Production remains warm, sandbox green, and the Kubernetes icon blue without vivid fills.
kubernetes_icon = "#8ab4d9"
# Secondary telemetry is intentionally subdued on black.
utility = "#77808c"
prod = "#e0a0a8"
prod_alt = "#caa6d4"
sandbox = "#9bc7a8"
green = "#a6e3a1"
red = "#f38ba8"
yellow = "#f9e2af"
