#!/usr/bin/env bash
#MISE description="Generate bash completions for flux, gh, helm, kubectl, kustomize, mise, and zoxide"
#MISE sources=["{{ .chezmoi.homeDir }}/.config/mise/config.toml", "{{ .chezmoi.homeDir }}/.config/mise/mise.lock"]
#MISE outputs=["{{ .chezmoi.homeDir }}/.local/bash-completions/flux", "{{ .chezmoi.homeDir }}/.local/bash-completions/gh", "{{ .chezmoi.homeDir }}/.local/bash-completions/helm", "{{ .chezmoi.homeDir }}/.local/bash-completions/kubectl", "{{ .chezmoi.homeDir }}/.local/bash-completions/kustomize", "{{ .chezmoi.homeDir }}/.local/bash-completions/mise", "{{ .chezmoi.homeDir }}/.local/bash-completions/zoxide"]
# PoC (#747 C2): bare names, no version pins. Confirmed empirically that mise resolves each of
# these against whatever version is already pinned in the ambient [tools] table in config.toml --
# even where the config key is a full backend spec ("aqua:cli/cli") rather than the bare registry
# name ("gh") used here. That keeps the version pin single-sourced in config.toml (Renovate-managed)
# instead of duplicated in this task. "mise" is the one exception: config.toml has no [tools] entry
# for mise itself (it's seeded by run_before_20_mise-first-time, not Renovate-managed here), so this
# resolves to whatever "mise" is already first on PATH rather than a pinned/installed copy -- it
# documents intent but does not actually pin a version. Declaring these removes the need for the
# caller to have run `eval "$(mise activate bash)"` first (see #728) -- four scripts still do that.
#MISE tools=["flux", "gh", "helm", "kubectl", "kustomize", "mise", "zoxide"]
#MISE env={DOTFILES_COMPLETIONS_DUMMY_SECRET="not-a-real-secret"}
#USAGE flag "--output-dir <dir>" default="{{ .chezmoi.homeDir }}/.local/bash-completions" help="Directory to write generated completion scripts into"

# PoC (#747 C2) finding, falsifiable and reproduced against mise 2026.8.3 in a scratch rig (positive
# and negative control, same rig): config-level `redactions` (config.toml) DOES mask a `#MISE env=`
# value -- DOTFILES_COMPLETIONS_DUMMY_SECRET above prints as "[redacted]" in `mise run` stdout, on a
# default run and a forced re-run alike. It does NOT mask a `#USAGE`-flag-derived `usage_*` value:
# an earlier version of this file carried a second, dummy `#USAGE` flag named identically in
# `redactions` (see config.toml's comment for the exact falsification and the
# exact-case-sensitivity gotcha) and it printed in the clear, default and CLI-supplied alike --
# `--output-dir` above was never itself a redaction target, it's the standing example of what
# `#USAGE` stays good for: ordinary, non-secret parameters.
# Root cause: `redactions` resolves against the env map built *before* #USAGE values are merged in,
# so the #USAGE lookup never fires -- there's no separate #MISE-level syntax or sensitivity flag
# that covers it, on this mise version. Checked mise's own debug log too, at the setting that
# actually enables it (MISE_LOG_FILE_LEVEL=debug alone is a no-op -- MISE_LOG_LEVEL=debug is what
# opens the gate): task stdout is never mirrored there either way, so "0 occurrences in the log"
# never meant redaction was working -- stdout is the only leak surface. And with real debug logging
# on and a CLI-supplied value, the log leaks that value **twice** (the `DEBUG ARGS:` line and the
# unredacted command-echo line) regardless of which channel carried it in.
#
# Net rule for phase 5: route `bitwardenSecrets` values through `#MISE env=` (this task's
# DOTFILES_COMPLETIONS_DUMMY_SECRET is the pattern), never through a `#USAGE` flag -- `#USAGE` stays
# for ordinary, non-secret parameters like --output-dir above. It's the obvious channel to reach for
# since it's already typed and named, which is exactly why this needs to be written down rather than
# rediscovered under time pressure once phase 5 has real secrets in play.

set -euo pipefail

# shellcheck disable=SC2154 # usage_output_dir is injected by mise's #USAGE parsing at run time
output_dir="${usage_output_dir}"
echo "dotfiles:completions | dummy secret received via env= (expected to be masked -- see comment above): ${DOTFILES_COMPLETIONS_DUMMY_SECRET}"

mkdir -p "${output_dir}"

flux completion bash > "${output_dir}/flux"
gh completion -s bash > "${output_dir}/gh"
helm completion bash > "${output_dir}/helm"
kubectl completion bash > "${output_dir}/kubectl"
kustomize completion bash > "${output_dir}/kustomize"
# #728: this file must be written before zoxide's below, and the two must target different
# filenames ("mise" vs "zoxide"). The original bug had zoxide's line targeting "mise", clobbering
# the completion written here. If either the target filename or the ordering is changed again,
# this silently reintroduces that bug -- neither command errors, only one file ends up wrong.
mise completion bash --include-bash-completion-lib > "${output_dir}/mise"
zoxide init bash > "${output_dir}/zoxide"

echo "dotfiles:completions | wrote 7 completion files to ${output_dir}"
