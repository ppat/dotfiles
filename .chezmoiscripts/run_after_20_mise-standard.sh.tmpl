#!/usr/bin/env bash
set -euo pipefail

set -o allexport
{{ template "mise.env" . -}}
{{ template "node.env" . -}}
{{ template "homebrew.env" . -}}
set +o allexport
export PATH=${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin:${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:$PATH

{{ template "script_header.sh" . }}
{{ template "script_mise.sh" . }}


main() {
  local setup_type="Standard"

  mise_prerequisites $setup_type
  show_mise_env $setup_type
  echo

  if ! [[ -d "$MISE_CACHE_DIR" && -d "$MISE_DATA_DIR" && -d "$MISE_STATE_DIR" ]]; then
    log_error "Mise | $setup_type | First time setup has not been run, cannot run standard setup..."
    exit 1
  fi

  # The lockfile is .chezmoiignore'd (#728) precisely so chezmoi never manages it as a normal
  # target -- doing so produced drift on every run and hard-failed non-interactively. This `cp`
  # is how a Renovate-driven checksum bump in the source-of-truth lockfile reaches the machine
  # *before* `mise upgrade` verifies against it below, and that guarantee is load-bearing: do
  # not remove the cp, and do not make chezmoi manage mise.lock instead.
  #
  # It IS conditional on content, not unconditional, because an unconditional `cp` bumps the
  # destination's mtime on every apply even when the bytes are byte-identical. This was originally
  # caught (PoC #747) because it defeated a mise task's mtime-based `sources=` staleness cache --
  # that task has since been retired (see DESIGN.md's "Mise tasks and conf.d overlays" section),
  # but the underlying problem is general, not task-specific: needless mtime churn on a file
  # anything else might use as a staleness signal. Comparing first means an unchanged lockfile
  # leaves the destination's mtime untouched, while a genuinely changed one still lands before
  # `mise upgrade` runs, exactly as before. If you're tempted to simplify this back to a bare
  # `cp`, don't -- that reintroduces the needless-churn regression this comment is about.
  local mise_lock_src="{{ .chezmoi.sourceDir }}/private_dot_config/mise/mise.lock"
  local mise_lock_dst="$(dirname "${MISE_GLOBAL_CONFIG_FILE}")/mise.lock"
  if [[ -f "$mise_lock_dst" ]] && cmp -s "$mise_lock_src" "$mise_lock_dst"; then
    log_info "Mise | $setup_type | mise.lock already matches source, leaving destination mtime untouched..."
  else
    log_info "Mise | $setup_type | Refreshing mise.lock from source (picks up Renovate-driven checksum updates)..."
    cp "$mise_lock_src" "$mise_lock_dst"
  fi
  echo

  setup_mise_packages $setup_type | sed -E 's|^(.*)|    \1|g'
  echo
  apply_bootstrap_packages $setup_type | sed -E 's|^(.*)|    \1|g'
  echo
  # `mise prune` re-serializes and rewrites mise.lock on every invocation, even when nothing is
  # actually pruned -- confirmed empirically (identical before/after bytes, fresh mtime either
  # way). That is the exact same needless-mtime-churn mechanism as the `cp` above (see that
  # comment), just triggered by a different command further down this same script: fixing only
  # the `cp` left this rewrite alone still bumping mise.lock's mtime on every apply, confirmed in
  # a real pod during PoC #747. Snapshot mise.lock (content + mtime) beforehand and
  # restore the old mtime afterward whenever prune's output is byte-identical, so a no-op prune
  # doesn't invalidate the cache either -- while a prune that genuinely removes something still
  # gets a fresh mtime, correctly invalidating it.
  local mise_lock_pre_prune
  mise_lock_pre_prune="$(mktemp)"
  cp -p "$mise_lock_dst" "$mise_lock_pre_prune" 2>/dev/null || true
  log_success "Mise | $setup_type | Pruning unused packages..."
  mise prune --yes 2>&1 | sed -E 's|^(.*)|    \1|g'
  if [[ -s "$mise_lock_pre_prune" ]] && cmp -s "$mise_lock_pre_prune" "$mise_lock_dst"; then
    touch -r "$mise_lock_pre_prune" "$mise_lock_dst"
  fi
  rm -f "$mise_lock_pre_prune"
  echo
  display_installed_mise_packages $setup_type
  log_success "Mise | $setup_type | Complete!"
  echo "-------------------------------------------------------------------------------------------"
  echo
}

main
