#!/usr/bin/env bash
set -euo pipefail

set -o allexport
{{ template "mise.env" . -}}
{{ template "homebrew.env" . -}}
set +o allexport
export PATH=${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin:${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:$PATH
{{ if eq .chezmoi.os "darwin" }}
export LITELLM_APIKEY="{{ (bitwardenSecrets "b443797d-f93f-4e01-a8ae-b49100825b18" .bwsAccessToken).value }}"
{{ else }}
export LITELLM_APIKEY="{{ (bitwardenSecrets "3d97880e-879d-48ed-aa1c-b4910081d2ef" .bwsAccessToken).value }}"
{{ end }}
export DOMAIN_NAME="{{ (bitwardenSecrets "288eeda0-d57f-4a91-8651-b2090163ecc0" .bwsAccessToken).value }}"

{{ template "script_header.sh" . }}

# Re-enter this script once under `mise exec`, so the tools it needs are resolved (and installed if
# missing) and placed on PATH. The sentinel env var makes the re-entry happen exactly once.
# NOTE: `jq` has no pin in private_dot_config/mise/config.toml, so it resolves to the latest release
# rather than a mise.lock-verified version -- unlike every other spec named across these scripts.
if [[ -z "${DOTFILES_CLAUDE_BOOTSTRAPPED:-}" ]]; then
  if ! command -v mise > /dev/null; then
    log_error "Claude Code | Mise binary is not in path, cannot proceed!"
    exit 1
  fi
  export DOTFILES_CLAUDE_BOOTSTRAPPED=1
  exec mise exec "npm:@anthropic-ai/claude-code" "jq" -- "${BASH_SOURCE[0]}" "$@"
fi

configure_mcp_servers() {
  for mcp in context7 github grafana home_assistant kubernetes_homelab kubernetes_nas kubernetes_sandbox playwright unifi_network unifi_protect; do
    if ! claude mcp get ${mcp} > /dev/null 2>&1; then
      log_info "Claude Code | Adding ${mcp} MCP server..."
      claude mcp add --scope user ${mcp} --transport http ${mcp} https://litellm.homelab.${DOMAIN_NAME}/${mcp}_mcp/mcp --header "x-litellm-api-key: Bearer ${LITELLM_APIKEY}"
      log_success "Claude Code | ${mcp} MCP server added."
    else
      log_info "Claude Code | ${mcp} MCP server already configured, skipping."
    fi
  done
}

configure_plugin_marketplaces() {
  if ! claude plugin marketplace list --json | jq -e 'any(.name == "claude-plugins-official")' > /dev/null; then
    log_info "Claude Code | Adding claude-plugins-official marketplace..."
    claude plugin marketplace add anthropics/claude-plugins-official 2>&1 | sed -E 's|^(.*)|    \1|g'
    log_success "Claude Code | claude-plugins-official marketplace added."
  else
    log_info "Claude Code | claude-plugins-official marketplace already configured, skipping."
  fi
}

configure_plugins() {
  local installed_ids
  installed_ids=$(claude plugin list --json | jq -r '.[].id')

  jq -r '.enabledPlugins | to_entries[] | select(.value == true) | .key' ~/.claude/settings.json | while read -r plugin_id; do
    if ! grep -qxF "$plugin_id" <<< "$installed_ids"; then
      log_info "Claude Code | Installing plugin ${plugin_id}..."
      claude plugin install "$plugin_id" 2>&1 | sed -E 's|^(.*)|    \1|g'
      log_success "Claude Code | Plugin ${plugin_id} installed."
    else
      log_info "Claude Code | Plugin ${plugin_id} already installed, skipping."
    fi
  done
}

main() {
  log_info "Claude Code | Configuring MCP servers..."
  configure_mcp_servers 2>&1 | sed -E 's|^(.*)|    \1|g'
  echo
  log_info "Claude Code | Configuring plugin marketplaces..."
  configure_plugin_marketplaces 2>&1 | sed -E 's|^(.*)|    \1|g'
  echo
  log_info "Claude Code | Installing plugins enabled in settings.json..."
  configure_plugins 2>&1 | sed -E 's|^(.*)|    \1|g'
  echo "-------------------------------------------------------------------------------------------"
  echo
}

main
