#!/usr/bin/env bash
# Thin wrapper: chezmoi owns *when* this runs, the mise task owns *what* it does.
#
# `run_after_` (not `run_onchange_`) is deliberate. `run_onchange_` hashes the rendered *wrapper*, so a
# change confined to the task file would leave the hash untouched and the work would silently never
# re-run (#747 §C5). Since this wrapper's body never changes, `run_onchange_` would mean "run once,
# ever". `run_after_` keeps today's semantics: reconcile on every apply.
set -euo pipefail

set -o allexport
{{ template "mise.env" . -}}
{{ template "homebrew.env" . -}}
set +o allexport
export PATH=$HOME/.local/bin:${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:$PATH

{{ template "script_header.sh" . }}

main() {
  if ! command -v mise > /dev/null; then
    log_error "Krew Plugins | Mise binary is not in path, cannot proceed!"
    exit 1
  fi
  mise run dotfiles:krew
  echo "-------------------------------------------------------------------------------------------"
  echo
}

main
