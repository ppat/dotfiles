#!/usr/bin/env bash
# =====================================================================================================
# PoC #747 verdict: SCRIPT form, not a mise task. The task-form counterfactual this was judged against is
# preserved (not deployed) in https://gist.github.com/ppat/ecca96047e599a58b121d513ec2c0b7e -- see also
# DESIGN.md's "Mise tasks and conf.d overlays" section for why it wasn't adopted.
#
# The improvements over the pre-PoC script are exactly the two the task form would otherwise be credited
# with, so that the comparison was not rigged:
#
#   P3 (tool resolution) -- `eval "$(mise activate bash)"` plus two `command -v` guards are replaced by
#      a single `mise exec <tools> --` re-exec. This is the script-form equivalent of a task's
#      `tools = [...]`: mise resolves (and installs) the tools against the same config.toml pins and
#      hands the body a PATH that already has them. Verified from a bare PATH=/usr/bin:/bin.
#
#   D4 (typed named parameters) -- the identical `#USAGE` header a mise task would carry, parsed by
#      `usage bash`. `usage` is a plain `[tools]` entry, not a mise-task feature. Verified: same
#      `usage_*` env vars, same `--help` rendering, same rejection of unknown flags.
# =====================================================================================================
#USAGE flag "--plugin-file <plugin_file>" help="newline-delimited list of krew plugins to install" default="{{ .chezmoi.homeDir }}/.local/share/dotfiles/krew-plugins.txt"
#USAGE flag "--krew-root <krew_root>" help="krew installation root" default="{{ .chezmoi.homeDir }}/.krew"
set -euo pipefail

set -o allexport
{{ template "mise.env" . -}}
{{ template "homebrew.env" . -}}
set +o allexport
export PATH=$HOME/.local/bin:${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:$PATH

{{ template "script_header.sh" . }}

# Re-exec once, under mise's toolset and usage's argument parser. Everything below the guard runs with
# kubectl/krew on PATH and the `usage_*` variables populated -- the same two guarantees `mise run` gives
# a file task, obtained without one.
if [[ -z "${DOTFILES_KREW_BOOTSTRAPPED:-}" ]]; then
  if ! command -v mise > /dev/null; then
    log_error "Krew Plugins | Mise binary is not in path, cannot proceed!"
    exit 1
  fi
  export DOTFILES_KREW_BOOTSTRAPPED=1
  exec mise exec "aqua:kubernetes/kubectl" "aqua:kubernetes-sigs/krew" usage \
    -- usage bash "${BASH_SOURCE[0]}" "$@"
fi

# `usage_*` are injected by the argument parser, so shellcheck cannot see them assigned. Identical cost
# in the task form -- it is a property of `usage`, not of mise tasks.
# shellcheck disable=SC2154
export KREW_ROOT="${usage_krew_root}"
# shellcheck disable=SC2154
readonly PLUGIN_FILE="${usage_plugin_file}"
export PATH="${KREW_ROOT}/bin:${PATH}"

krew_prerequisites() {
  log_info "Krew Plugins | Initializing krew..."
  if [[ ! -r "${PLUGIN_FILE}" ]]; then
    log_error "Krew Plugins | Plugin list not readable: ${PLUGIN_FILE}"
    exit 1
  fi
  if [[ ! -d "${KREW_ROOT}/bin" ]]; then
    log_info "Krew Plugins | Creating directories..."
    mkdir -p "${KREW_ROOT}/bin"
  fi
}

update_krew_index() {
  log_info "Krew Plugins | Updating index..."
  kubectl krew update
}

install_or_upgrade_plugins() {
  log_info "Krew Plugins | Detecting installed krew plugins..."
  local installed_list
  installed_list=$(mktemp -t "krew.installed.XXXXX")
  # shellcheck disable=SC2064
  trap "rm -f '$installed_list'" EXIT
  kubectl krew list > "$installed_list"
  echo
  log_info "Krew Plugins | Upgrading existing plugins..."
  kubectl krew upgrade --no-update-index
  echo
  log_info "Krew Plugins | Installing new plugins..."
  while read -r plugin; do
    if [[ -n "$plugin" && ! "$plugin" =~ ^# ]]; then
      if ! grep -qx "$plugin" "$installed_list"; then
        kubectl krew install --no-update-index "$plugin"
      fi
    fi
  done < "${PLUGIN_FILE}"
  log_success "Krew Plugins | Krew plugins installed successfully!"
}

display_installed_plugins() {
  log_info "Krew Plugins | Display installed packages..."
  kubectl krew list | column -t
}

main() {
  krew_prerequisites
  echo
  update_krew_index
  echo
  install_or_upgrade_plugins
  echo
  display_installed_plugins
  echo "-------------------------------------------------------------------------------------------"
  echo
}

main
