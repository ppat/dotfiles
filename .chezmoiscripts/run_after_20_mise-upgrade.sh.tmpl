#!/usr/bin/env bash
set -euo pipefail

set -o allexport
{{ template "mise.env" . -}}
{{ template "node.env" . -}}
{{ template "homebrew.env" . -}}
set +o allexport
export PATH=${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin:${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:$PATH

{{ template "script_header.sh" . }}
{{ template "script_mise.sh" . }}


main() {
  mise_prerequisites
  show_mise_env
  echo

  log_info "Mise | Refreshing mise.lock from source (picks up Renovate-driven checksum updates)..."
  cp {{ .chezmoi.sourceDir }}/private_dot_config/mise/mise.lock "$(dirname "${MISE_GLOBAL_CONFIG_FILE}")/mise.lock"
  echo

  upgrade_mise_packages | sed -E 's|^(.*)|    \1|g'
  echo
  log_success "Mise | Pruning unused packages..."
  mise prune --yes 2>&1 | sed -E 's|^(.*)|    \1|g'
  echo
  display_installed_mise_packages
  log_success "Mise | Upgrade complete!"
  echo "-------------------------------------------------------------------------------------------"
  echo
}

main
