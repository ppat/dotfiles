{
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  // Use solid cursor instead of blinking to reduce UI updates
  "editor.cursorBlinking": "solid",
  // Disable animated cursor movements
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.fontFamily": "Fira Code, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 14,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",
  // Wait longer before showing hover tooltips (default: 300ms)
  "editor.hover.delay": 5000,
  // Limit processing for very long lines to prevent parser hangs
  "editor.maxTokenizationLineLength": 10000,
  // Disable the code minimap on the right side to reduce rendering overhead
  "editor.minimap.enabled": false,
  // Disable highlighting all instances of selected text
  "editor.occurrencesHighlight": "off",
  // Wait longer before showing parameter hint popups (default: ~120ms)
  "editor.parameterHints.delay": 1000,
  // Control when suggestion popups appear - only in code, not in comments or strings
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.renderWhitespace": "none",
  // Advanced language-aware syntax highlighting
  "editor.semanticHighlighting.enabled": true,
  // ANIMATION AND SCROLLING
  "editor.smoothScrolling": false,
  "editor.scrollbar.horizontal": "visible",
  "editor.scrollbar.vertical": "visible",
  // Increase delay before showing code completion suggestions (default: 10ms)
  "editor.suggestDelay": 3000,
  "editor.suggest.preview": true,
  // Prevent extensions from automatically updating in the background.
  // "off" (not boolean false) matches the current extensions.autoUpdate schema -- VS Code
  // migrates a legacy boolean to "on"/"off" automatically, but writing the string directly
  // avoids relying on that migration (and an in-place rewrite of this chezmoi-managed file).
  "extensions.autoUpdate": "off",
  "extensions.autoCheckUpdates": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 300,
  // Exclude large/generated directories from file watching to reduce I/O and CPU load.
  // The remote (Coder workspace) home holds an 11 GB ~/.vscode-server tree that VS Code
  // would otherwise watch recursively (including itself), plus a Homebrew symlink farm and
  // every installed mise toolchain version -- none of these are ever hand-edited.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.vscode-server/**": true,
    "**/.linuxbrew/**": true,
    "**/.local/share/mise/**": true,
    "**/.terraform/**": true,
    "**/.cache/**": true,
    "**/.cargo/**": true,
    "**/go/pkg/**": true,
    "**/.claude/**": true,
    "**/target/**": true,
    "**/vendor/**": true,
    "**/.venv/**": true
  },
  // Same directories as files.watcherExclude -- keep full-text search from indexing them too.
  "search.exclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.vscode-server/**": true,
    "**/.linuxbrew/**": true,
    "**/.local/share/mise/**": true,
    "**/.terraform/**": true,
    "**/.cache/**": true,
    "**/.cargo/**": true,
    "**/go/pkg/**": true,
    "**/.claude/**": true,
    "**/target/**": true,
    "**/vendor/**": true,
    "**/.venv/**": true
  },
  // Homebrew/mise symlink farms make plain (non-excluded) symlink traversal expensive.
  "search.followSymlinks": false,
  // Cap the TypeScript server's heap instead of leaving it unbounded.
  "typescript.tsserver.maxTsServerMemory": 2048,
  "typescript.disableAutomaticTypeAcquisition": true,
  // Reduce the git extension's background repository scanning.
  "git.autoRepositoryDetection": "openEditors",
  "git.repositoryScanMaxDepth": 1,
  "git.autofetch": false,
  "telemetry.telemetryLevel": "off",
  "window.restoreWindows": "preserve",
  "window.zoomLevel": 0,
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  // Disable smooth scrolling in file lists and menus
  "workbench.list.smoothScrolling": false,

  "remote.SSH.connectTimeout": 1800,
  // Host key matches the "coder-vscode.<deployment>--<username>--<workspace>.<agent>" format
  // that the Coder VS Code extension's SSH authority parser actually produces (verified against
  // coder/vscode-coder's src/util/authority.ts). A second, differently-shaped entry that used
  // to live here (a "--<workspace>--<agent>" tail instead of ".<agent>") does not parse under
  // that scheme -- it predates the current extension version and was dropped rather than
  // templated (dotfiles#772).
  "remote.SSH.remotePlatform": {
    "coder-vscode.coder.{{ (bitwardenSecrets "288eeda0-d57f-4a91-8651-b2090163ecc0" .bwsAccessToken).value }}--{{ .coderUsername }}--{{ .coderUsername }}.main": "linux"
  },
  // APPLICATION/WINDOW-scoped in VS Code's own configuration registry (never MACHINE or
  // MACHINE_OVERRIDABLE), so it must live in this file -- the remote Machine settings file
  // parses only [MACHINE, MACHINE_OVERRIDABLE] scopes and silently drops anything else.
  "remote.extensionKind": {
    "vscode-icons-team.vscode-icons": ["ui"],
    "bierner.markdown-mermaid": ["ui"]
  },
  "remote.SSH.defaultExtensions": [
    "bierner.markdown-mermaid",
    "DavidAnson.vscode-markdownlint",
    // "EditorConfig.EditorConfig",
    // "github.vscode-github-actions",
    "hashicorp.hcl",
    "hashicorp.terraform",
    // "irongeek.vscode-env",
    "hverlin.mise-vscode",
    // "ms-azuretools.vscode-docker",
    "ms-kubernetes-tools.vscode-kubernetes-tools",
    // "ms-python.debugpy",
    // "ms-python.python",
    // "ms-python.vscode-pylance",
    // "redhat.ansible",
    "redhat.vscode-yaml",
    "RooVeterinaryInc.roo-cline",
    // "streetsidesoftware.code-spell-checker",
    "samuelcolvin.jinjahtml",
    // "timonwong.shellcheck",
    "vscode-icons-team.vscode-icons",
  ],
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "disabled",
    // Prevent auto-refresh of cluster resources
    "disable-automatic-refresh": true,
    // Set default output format
    "outputFormat": "yaml",
    // Skip checking for Minikube updates
    "checkForMinikubeUpgrade": false,
  },
  "security.workspace.trust.untrustedFiles": "open",
  "roo-cline.allowedCommands": [
    "git log",
    "git diff",
    "git show",
    "cd",
    "yamllint",
    "kubectl --dry-run=client",
    "npm test",
    "tsc"
  ],
  "roo-cline.vsCodeLmModelSelector": {

  },
  "cSpell.enabled": false,
  "cSpell.showAutocompleteDirectiveSuggestions": false,
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": false
  },





  // YAML EXTENSION SETTINGS
  // Empty schema map to prevent schema validation lookups
  // "yaml.schemas": { },
  // Turn off YAML validation to reduce background processing
  // "yaml.validate": false,
  // Disable hover information for YAML keys
  "yaml.hover": false,
  // Disable code completion for YAML
  "yaml.completion": false,
  // Disable automatic formatting for YAML files
  // "yaml.format.enable": false,

  // TERRAFORM EXTENSION SETTINGS
  // Limit the number of problems reported by Terraform language server
  "terraform.languageServer": {
    "maxNumberOfProblems": 100,
    // Skip processing root modules to improve performance
    "excludeRootModules": true
  },
  // Disable displaying reference counts above code blocks
  "terraform.codelens.referenceCount": false,
  // Disable background indexing of Terraform files
  "terraform.indexing": {
    "enabled": false,
    "liveIndexing": false
  },
  // Turn off automatic validation of Terraform files
  "terraform.validation": {
    "enable": false
  },

  // MARKDOWN MERMAID SETTINGS
  // Use fit mode for diagrams instead of complex scaling
  "markdown.mermaid.zoomSettings": "fit",

  // VSCODE-ICONS SETTINGS
  // Prevent update notification popups for icon packs
  "vsicons.dontShowNewVersionMessage": true,

  // JINJA HTML SETTINGS
  // Disable Emmet abbreviation expansion within Jinja templates
  "jinjahtml.enableEmmetForJinja": false,

  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.scrollback": 10000
}
