#!/usr/bin/env bash
# Mint (with caching) a GitHub App installation token for the agent identity and print
# an `export GH_TOKEN=...` line for eval by ~/.local/bash/gh-agent.bash.
#
# Fail-soft by design: if the App is not configured (files missing, <<TODO>> UUIDs not
# yet filled, or CI's fake-test-value substitution), print nothing and exit 0 so shell
# startup never breaks. If the App IS configured but minting fails (network, clock,
# revoked key), print a comment line -- eval ignores it -- and exit 0, so the failure
# surfaces as unauthenticated gh calls rather than a broken shell.
set -euo pipefail

conf_dir="${HOME}/.config/gh-agent"
cache_dir="${HOME}/.cache/gh-agent"
app_id_file="${conf_dir}/app-id"
key_file="${conf_dir}/app.pem"

[[ -r "${app_id_file}" && -r "${key_file}" ]] || exit 0
app_id="$(tr -d '[:space:]' < "${app_id_file}")"
case "${app_id}" in
  '' | *TODO* | fake-test-value) exit 0 ;;
esac
grep -q 'PRIVATE KEY' "${key_file}" || exit 0

mkdir -p "${cache_dir}"
chmod 700 "${cache_dir}"
token_file="${cache_dir}/token"
expiry_file="${cache_dir}/token-expiry"
install_file="${cache_dir}/installation-id"

now="$(date -u +%s)"

emit() {
  printf 'export GH_TOKEN=%q\n' "$(cat "${token_file}")"
}

# Serve from cache while >=10 minutes of the token's one-hour life remain.
if [[ -s "${token_file}" && -s "${expiry_file}" ]]; then
  expiry="$(cat "${expiry_file}")"
  if [[ "${expiry}" =~ ^[0-9]+$ ]] && (( expiry - now > 600 )); then
    emit
    exit 0
  fi
fi

b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# App JWT: iat backdated 60s for clock skew, exp 9 minutes out (GitHub max is 10).
header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "${app_id}" | b64url)"
signature="$(printf '%s.%s' "${header}" "${payload}" | openssl dgst -sha256 -sign "${key_file}" -binary | b64url)"
jwt="${header}.${payload}.${signature}"

api='https://api.github.com'
hdr_accept='Accept: application/vnd.github+json'

if [[ ! -s "${install_file}" ]]; then
  if ! curl -fsS --max-time 15 -H "Authorization: Bearer ${jwt}" -H "${hdr_accept}" \
      "${api}/app/installations" | jq -er '.[0].id' > "${install_file}" 2> /dev/null; then
    rm -f "${install_file}"
    echo '# gh-app-env: could not resolve the App installation id (network? key revoked?)'
    exit 0
  fi
fi
installation_id="$(cat "${install_file}")"

if ! response="$(curl -fsS --max-time 15 -X POST -H "Authorization: Bearer ${jwt}" -H "${hdr_accept}" \
    "${api}/app/installations/${installation_id}/access_tokens")"; then
  echo '# gh-app-env: token mint failed (network? App uninstalled? key revoked?)'
  exit 0
fi

token="$(jq -er '.token' <<< "${response}")"
expires_at="$(jq -er '.expires_at' <<< "${response}")"

umask 077
printf '%s' "${token}" > "${token_file}"
date -u -d "${expires_at}" +%s > "${expiry_file}"
emit
