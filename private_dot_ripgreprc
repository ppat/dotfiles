# -----------------------------------------------------------------------------
# Search & Filtering Rules
# -----------------------------------------------------------------------------

# Search hidden files and directories (e.g., .env, .github/, .terraform/) by default
--hidden

# Hard safety blocks (applied even if a .gitignore is missing)
--glob=!.git/
--glob=!.terraform/

# -----------------------------------------------------------------------------
# UI & Output Formatting
# -----------------------------------------------------------------------------
--pretty

# Group matches by file name rather than printing the file name on every line
--heading

# Show line numbers for every match
--line-number

# -----------------------------------------------------------------------------
# Custom Infrastructure & Backend File Types
# -----------------------------------------------------------------------------

# Add/extend custom type mappings for quick filtering (e.g., rg -t tf "variable")
--type-add=tf:*.tf*
--type-add=k8s:*.yaml
--type-add=k8s:*.yml
--type-add=env:*.env*
--type-add=docker:Dockerfile*
--type-add=docker:docker-compose*
--type-add=docker:compose*
--type-add=md:*.md
