{
  "description": "Personal Codex guardrails and advisory edit linting.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {"type": "command", "command": "$HOME/.codex/hooks/lint-on-edit.sh", "timeout": 15}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {"type": "command", "command": "$HOME/.codex/hooks/guard-pre-tool-use.sh", "timeout": 10}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/coder/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
