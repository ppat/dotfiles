approval_policy = "on-request"
approvals_reviewer = "auto_review"
check_for_update_on_startup = false
cli_auth_credentials_store = "auto"
{{ if eq .chezmoi.homeDir "/home/coder" -}}
sandbox_mode = "danger-full-access"
{{- else if eq .chezmoi.os "darwin" }}
default_permissions = "code"
{{ end -}}
project_doc_fallback_filenames = ["CLAUDE.md"]
web_search = "live"

{{ if eq .chezmoi.os "darwin" -}}
[permissions.code]
description = "Development access under ~/code with credentials denied."
extends = ":workspace"

[permissions.code.workspace_roots]
"~/code" = true

[permissions.code.filesystem]
"~/.claude.json" = "deny"
"~/.claude/.credentials.json" = "deny"
"~/.codex/.managed.toml" = "deny"
"~/.codex/auth.json" = "deny"
"~/.codex/config.toml" = "deny"
"~/.config/chezmoi/chezmoi.toml" = "deny"
"~/.config/gh" = "deny"
"~/.config/gh-agent" = "deny"
"~/.config/sandbox-talos" = "deny"
"~/.env" = "deny"
"~/.env.overrides" = "deny"
"~/.env.secrets" = "deny"
"~/.kube" = "deny"
"~/.secrets" = "deny"
"~/.ssh" = "deny"
"~/.talos" = "deny"
{{- end }}

[analytics]
enabled = false

[features]
memories = true

[mcp_servers.context7]
url = "https://litellm.homelab.{{ (bitwardenSecrets "288eeda0-d57f-4a91-8651-b2090163ecc0" .bwsAccessToken).value }}/context7_mcp/mcp"
http_headers = { "x-litellm-api-key" = "Bearer {{ if eq .chezmoi.os "darwin" }}{{ (bitwardenSecrets "b443797d-f93f-4e01-a8ae-b49100825b18" .bwsAccessToken).value }}{{ else }}{{ (bitwardenSecrets "3d97880e-879d-48ed-aa1c-b4910081d2ef" .bwsAccessToken).value }}{{ end }}" }

